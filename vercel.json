{
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/terminal",
      "destination": "/app.html"
    },
    {
      "source": "/hoy",
      "destination": "/hoy.html"
    }
  ],
  "crons": [
    {
      "path": "/api/agents-run",
      "schedule": "30 22 * * 1-5"
    },
    {
      "path": "/api/arena-run",
      "schedule": "40 22 * * 1-5"
    },
    {
      "path": "/api/arena-run?phase=reconcile",
      "schedule": "40 14 * * 1-5"
    },
    {
      "path": "/api/pead-harvest?job=earnings",
      "schedule": "0 12,14,16,18,20 * * *"
    },
    {
      "path": "/api/pead-harvest?job=hour",
      "schedule": "30 21 * * *"
    },
    {
      "path": "/api/arena-screener?job=refresh",
      "schedule": "0 */4 * * *"
    }
  ]
}
