{
  "functions": {
    "api/arena-run.js": {
      "maxDuration": 300
    },
    "api/arena-watch.js": {
      "maxDuration": 300
    },
    "api/arena-smoke.js": {
      "maxDuration": 300
    },
    "api/arena-reset.js": {
      "maxDuration": 300
    },
    "api/arena-universe.js": {
      "maxDuration": 300
    },
    "api/arena-shadow.js": {
      "maxDuration": 300
    },
    "api/arena-screener.js": {
      "maxDuration": 300
    },
    "api/arena-audit.js": {
      "maxDuration": 300
    },
    "api/pead-analyze.js": {
      "maxDuration": 300
    },
    "api/pead-harvest.js": {
      "maxDuration": 300
    },
    "api/dualmom-analyze.js": {
      "maxDuration": 300
    },
    "api/rotation-analyze.js": {
      "maxDuration": 300
    },
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/terminal",
      "destination": "/app.html"
    },
    {
      "source": "/hoy",
      "destination": "/hoy.html"
    },
    {
      "source": "/leaderboard",
      "destination": "/leaderboard.html"
    },
    {
      "source": "/liga",
      "destination": "/leaderboard.html"
    },
    {
      "source": "/api/liga/eventos",
      "destination": "/api/liga-eventos"
    },
    {
      "source": "/api/liga/libros",
      "destination": "/api/liga-libros"
    }
  ],
  "crons": [
    {
      "path": "/api/agents-run",
      "schedule": "30 22 * * 1-5"
    },
    {
      "path": "/api/arena-run",
      "schedule": "40 22 * * 1-5"
    },
    {
      "path": "/api/arena-run?phase=reconcile",
      "schedule": "40 14 * * 1-5"
    },
    {
      "path": "/api/arena-run?phase=morning",
      "schedule": "50 14 * * 1-5"
    },
    {
      "path": "/api/pead-harvest?job=hour",
      "schedule": "30 21 * * *"
    },
    {
      "path": "/api/arena-universe",
      "schedule": "0 13 * * 1-5"
    },
    {
      "path": "/api/arena-watch",
      "schedule": "*/5 13-21 * * 1-5"
    }
  ]
}
