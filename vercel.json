  "crons": [
    {
      "path": "/api/agents-run",
      "schedule": "30 22 * * 1-5"
    },
    {
      "path": "/api/arena-run",
      "schedule": "40 22 * * 1-5"
    },
    {
      "path": "/api/arena-run?phase=reconcile",
      "schedule": "40 14 * * 1-5"
    },
    {
      "path": "/api/arena-run?phase=morning",
      "schedule": "50 14 * * 1-5"
    },
    {
      "path": "/api/pead-harvest?job=hour",
      "schedule": "30 21 * * *"
    },
    {
      "path": "/api/earnings-beat-harvest?job=mercados",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/earnings-beat-harvest?job=precios",
      "schedule": "40 23 * * *"
    },
    {
      "path": "/api/arena-universe",
      "schedule": "0 13 * * 1-5"
    },
    {
      "path": "/api/arena-watch",
      "schedule": "*/5 13-21 * * 1-5"
    },
    {
      "path": "/api/xbrl-capture?run=1",
      "schedule": "0 13 * * 1"
    },
    {
      "path": "/api/mercado-r0?job=universo",
      "schedule": "30,45 13-21 * * 1-5"
    },
    {
      "path": "/api/bmv-harvest?job=precios",
      "schedule": "10 22 * * 1-5"
    },
    {
      "path": "/api/mercado-precios?job=us",
      "schedule": "20,35,50 21 * * 1-5"
    }
  ]
