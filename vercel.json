{
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/terminal",
      "destination": "/app.html"
    }
  ],
  "crons": [
    {
      "path": "/api/agents-run",
      "schedule": "30 22 * * 1-5"
    }
  ]
}
